# ---------------------------------------------------------------------------
# Lyka Realty — AI Property CRM : environment template
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# NEVER commit real secrets. No value below is a real credential.
# ---------------------------------------------------------------------------

# --- Runtime environment ---
# 'development' (default) or 'production'.
# In production SECRET_KEY is REQUIRED or the app refuses to start.
APP_ENV=development
DEBUG=0

# --- Flask session secret ---
# Generate one, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Hours a login session stays valid.
SESSION_HOURS=12

# --- Display currency (symbol/label only; stored prices are never changed) ---
# e.g. AED, INR, USD, $, £
CURRENCY=AED

# --- AI provider: OpenAI (preferred, official SDK) ---
# Leave blank to skip OpenAI and fall through to Groq, then the offline
# extractor. The key is only ever read server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- AI provider: Groq (fallback; SDK must be installed) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- AI request limits ---
AI_TIMEOUT_SECONDS=25
AI_ANALYSIS_RATE_LIMIT=10
AI_ANALYSIS_RATE_WINDOW=60

# --- AI assistant rate limiting (per client IP) ---
ASSISTANT_RATE_LIMIT=15
ASSISTANT_RATE_WINDOW=60
